# Copy this file to .env and fill in the real values.
# .env is gitignored - never commit it.

# Your Spond login (the same email and password you use in the Spond app).
SPOND_USERNAME=you@example.com
SPOND_PASSWORD=your-spond-password

# Path to the Google service account key file, relative to the project root.
# See README.md for how to create this.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
